def _task3_interval_different(original_module, a, b):
    """Reject only when outward-rounded intervals are disjoint."""
    import signal
    import threading
    import sympy as sp
    from mpmath.ctx_iv import MPIntervalContext

    # Keep this optional optimization bounded, including parsing.
    if threading.current_thread() is not threading.main_thread():
        return False
    if signal.getitimer(signal.ITIMER_REAL)[0] > 0:
        return False

    class IntervalBudgetExpired(Exception):
        pass

    def expired(signum, frame):
        raise IntervalBudgetExpired()

    previous_handler = signal.getsignal(signal.SIGALRM)
    signal.signal(signal.SIGALRM, expired)
    signal.setitimer(signal.ITIMER_REAL, 1.0)

    try:
        left = original_module.parse_math(a)
        right = original_module.parse_math(b)

        # Multiple parse candidates need the original verifier.
        if len(left) != 1 or len(right) != 1:
            return False

        x, y = left[0], right[0]
        if not isinstance(x, sp.Expr) or not isinstance(y, sp.Expr):
            return False

        # Do not guess a correspondence between different variables.
        if x.free_symbols and y.free_symbols:
            if x.free_symbols != y.free_symbols:
                return False

        symbols = sorted(x.free_symbols | y.free_symbols, key=str)
        if len(symbols) > 8:
            return False
        if any(symbol.is_integer is True for symbol in symbols):
            # The original checker handles assumption-sensitive cases.
            return False

        iv = MPIntervalContext()
        iv.dps = 50

        def evaluate(expr, substitutions):
            if expr.is_Integer:
                return iv.mpf(int(expr))
            if expr.is_Rational:
                return iv.mpf(int(expr.p)) / int(expr.q)
            if expr.is_Symbol:
                return iv.mpf(substitutions[expr])
            if expr.is_Add:
                result = iv.mpf(0)
                for arg in expr.args:
                    result += evaluate(arg, substitutions)
                return result
            if expr.is_Mul:
                result = iv.mpf(1)
                for arg in expr.args:
                    result *= evaluate(arg, substitutions)
                return result
            if expr.is_Pow and expr.exp.is_Rational:
                base = evaluate(expr.base, substitutions)
                # Positive bases avoid branch/domain ambiguities.
                if not bool(base.a > 0):
                    raise ValueError("Unsupported power domain")
                exponent = (
                    int(expr.exp)
                    if expr.exp.is_Integer
                    else evaluate(expr.exp, substitutions)
                )
                return base ** exponent
            raise ValueError("Use original verifier for this expression")

        # A valid counterexample disproves symbolic identity.
        # Overlapping intervals NEVER establish equality.
        seeds = (2, 3) if symbols else (2,)
        for seed in seeds:
            substitutions = {
                symbol: seed + index
                for index, symbol in enumerate(symbols)
            }
            p = evaluate(x, substitutions)
            q = evaluate(y, substitutions)
            if bool(p.b < q.a) or bool(q.b < p.a):
                return True

        return False
    except Exception:
        return False
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
        signal.signal(signal.SIGALRM, previous_handler)

import sympy as sp

class Parser:
    expressions = {}
    @classmethod
    def parse_math(cls, text):
        return [cls.expressions[text]]

a = sp.Symbol("a")
radical = sp.Pow(
    2 + sp.sqrt(2 + sp.sqrt(2)),
    2525,
    evaluate=False
)
huge = sp.Mul(
    sp.Pow(a, 100, evaluate=False),
    sp.Pow(2, (3**100 - 1)//2, evaluate=False),
    evaluate=False
)

Parser.expressions = {
    "small": 4096 * sp.sqrt(2),
    "radical": radical,
    "power": sp.Pow(2, 5150, evaluate=False),
    "huge": huge,
    "two": sp.Integer(2),
    "equal1": sp.sqrt(8),
    "equal2": 2 * sp.sqrt(2),
}

assert _task3_interval_different(Parser, "small", "radical")
assert _task3_interval_different(Parser, "power", "radical")
assert _task3_interval_different(Parser, "two", "huge")
assert not _task3_interval_different(Parser, "equal1", "equal2")
assert not _task3_interval_different(Parser, "radical", "radical")
print("[PASS] Large-power rejection and equality safeguards tested.")

